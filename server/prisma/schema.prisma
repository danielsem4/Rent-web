// rent+ Prisma schema
// learn more: https://pris.ly/d/prisma-schema
//
// This schema is reconciled to faithfully represent the live database
// (roles taxonomy, Company/User/Property, companyId NOT NULL). The datasource
// url is supplied via prisma.config.ts (Prisma 7 style), not here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  COMPANY_MANAGER
  COMPANY_WORKER
  RENTER
}

// Account-lifecycle token kinds (SECURITY_PRINCIPLES.md §3/§24). INVITATION lets a
// provisioned user set their first password; PASSWORD_RESET drives forgot/reset.
enum AccountTokenType {
  INVITATION
  PASSWORD_RESET
}

// Payment lifecycle. "Outstanding" = PENDING (not yet paid); "overdue" is derived
// at read time from dueDate, not stored.
enum PaymentStatus {
  PENDING
  PAID
}

// Kind of identity document attached to a Worker. `OTHER` is a catch-all.
enum WorkerDocumentType {
  PASSPORT
  VISA
  INSURANCE
  OTHER
}

// Utility / municipal bill categories for a Property. PROPERTY_TAX = Arnona,
// HOA = Vaad Bayit (building committee).
enum UtilityType {
  PROPERTY_TAX
  ELECTRICITY
  WATER
  HOA
  GAS
}

// Utility-bill lifecycle. Mirrors PaymentStatus: PENDING/PAID are stored;
// "overdue" is DERIVED at read time from dueDate, never persisted.
enum UtilityBillStatus {
  PENDING
  PAID
}

// Physical condition of an inventory item.
enum EquipmentCondition {
  NEW
  GOOD
  FAIR
  BROKEN
}

// Kind of guarantee/deposit held against a Property.
enum GuaranteeType {
  BANK_GUARANTEE
  CASH_DEPOSIT
  CHECK
  PROMISSORY_NOTE
  OTHER
}

// Guarantee/deposit lifecycle.
enum GuaranteeStatus {
  ACTIVE
  RETURNED
  EXPIRED
  CLAIMED
}

// Miscellaneous (non-rent) expense categories for a Property.
enum ExpenseCategory {
  CLEANING
  MAINTENANCE
  PEST_CONTROL
  OTHER
}

// Kind of request a foreign worker submits from the mobile app to the managing
// company. Deliberately coarse — the free-text `message` carries the detail.
enum WorkerRequestType {
  MAINTENANCE
  GENERAL
}

// Lifecycle of a worker-submitted request. Worker creates OPEN; staff transition
// it. Server-controlled (never set from the worker's request body).
enum WorkerRequestStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

// ─── Company ─────────────────────────────────────────────

model Company {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  properties      Property[]
  payments        Payment[]
  workers         Worker[]
  workerDocuments WorkerDocument[]
  propertyImages  PropertyImage[]
  // Property-detail groups (tenant-isolated by companyId)
  utilityBills    UtilityBill[]
  equipment       Equipment[]
  guarantees      Guarantee[]
  expenses        Expense[]
  inspections     Inspection[]
  workerRequests  WorkerRequest[]
}

// ─── User ────────────────────────────────────────────────
// role has no DB default (matches the live DB). companyId is required —
// every user belongs to a Company; SUPER_ADMIN is company-bound for now.

model User {
  id               Int       @id @default(autoincrement())
  email            String    @unique
  passwordHash     String
  name             String
  role             Role
  companyId        Int
  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Account status: a disabled user cannot authenticate and any already-issued
  // token is rejected on its next protected request (authenticate re-checks this).
  isActive         Boolean   @default(true)
  // Security/session version. Incrementing it invalidates every previously issued
  // JWT for this user (revoke-all). Tokens carry the version they were issued at.
  tokenVersion     Int       @default(0)
  // ─ Email OTP 2FA (SECURITY_PRINCIPLES.md §3/§24) ─
  // Mandatory for privileged roles (SUPER_ADMIN / COMPANY_MANAGER): on login a
  // single-use 6-digit code is emailed and its SHA-256 HASH stored here (never the
  // plaintext, §8). mfaCodeExpiresAt bounds its validity; mfaCodeAttempts counts
  // wrong tries for lockout. All three are cleared once a code is consumed.
  mfaCodeHash      String?
  mfaCodeExpiresAt DateTime?
  mfaCodeAttempts  Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  accountTokens AccountToken[]
  refreshTokens RefreshToken[]

  @@index([email])
  @@index([companyId])
}

// ─── AccountToken ────────────────────────────────────────
// Single-use, time-limited tokens for the account lifecycle (invitation /
// password-reset). Only the SHA-256 HASH of the random token is stored — the raw
// token is delivered to the user and never persisted or logged (SECURITY_PRINCIPLES.md
// §7/§18). A token is spent by setting `usedAt`; rows cascade-delete with the user.

model AccountToken {
  id        Int              @id @default(autoincrement())
  tokenHash String           @unique
  type      AccountTokenType
  userId    Int
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId])
}

// ─── RefreshToken ────────────────────────────────────────
// Stateful, rotating refresh tokens (SECURITY_PRINCIPLES.md §4 — the sanctioned
// per-session server-side revocation record). Only the SHA-256 HASH of the raw
// token is stored; the raw token lives only in an HttpOnly/Secure/SameSite cookie
// and is never persisted or logged (§7/§18). Each login starts a token FAMILY;
// every /refresh rotates (old row `isRevoked:true`, new row same `familyId`). If a
// revoked/expired token is replayed (reuse), the WHOLE family is revoked and the
// user's `tokenVersion` is bumped (revoke-all) — breach mitigation.
//
// DELIBERATE deviations from the repo's Int-autoincrement convention: `id` is a
// String UUID and `familyId` is a String UUID (rotation lineage). `userId` stays
// Int (FK to User.id) with onDelete: Cascade (rows die with the user).

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId  String
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([familyId])
}

// ─── AuditLog ────────────────────────────────────────────
// Append-only security audit trail (SECURITY_PRINCIPLES.md §18). Records
// security-sensitive events (login success/failure, user create, invitation,
// password reset, role change, session revocation).
//
// DELIBERATE deviation from the repo's "always FK + cascade" convention:
// `userId`/`companyId` are LOOSE nullable columns with NO foreign key, so an
// audit record is forensic evidence that SURVIVES deletion of the referenced
// user/company (a cascade would erase the trail). `metadata` is SANITIZED before
// write — it must NEVER contain passwords, tokens, tokenHash, cookies, or secrets.

model AuditLog {
  id           Int      @id @default(autoincrement())
  companyId    Int?
  userId       Int?
  action       String
  resourceType String
  resourceId   String?
  ipAddress    String?
  userAgent    String?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([companyId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ─── Property ────────────────────────────────────────────
// Schema definition only — reconciles with the live DB. No Property
// module/API/service/UI is built in this phase.

model Property {
  id                Int       @id @default(autoincrement())
  companyId         Int
  company           Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  city              String
  address           String
  entryCode         String?
  electricMeter     String?
  waterMeter        String?
  ownerName         String?
  ownerPhone        String?
  contractStart     DateTime?
  contractEnd       DateTime?
  // Advance notice period (in days) a tenant must give before contract end to
  // say whether they continue or leave. Nullable (no backfill) — additive, safe.
  advanceNoticeDays Int?
  monthlyRent       Int       @default(0)
  // Number of rooms. Nullable (no backfill) — additive, safe against the live DB.
  rooms             Int?
  maxCapacity       Int       @default(1)
  total             Int       @default(0)
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  payments     Payment[]
  workers      Worker[]
  images       PropertyImage[]
  utilityBills UtilityBill[]
  equipment    Equipment[]
  guarantees   Guarantee[]
  expenses     Expense[]
  inspections  Inspection[]

  @@index([companyId])
}

// ─── Payment ─────────────────────────────────────────────
// A rent payment owed for a Property, scoped to the owning Company (tenant
// isolation via companyId, mirroring Property). PENDING rows are the
// "outstanding payments" surfaced on the manager dashboard; PAID rows carry a
// paidAt timestamp. Both companyId and propertyId cascade-delete with their parent.

model Payment {
  id         Int           @id @default(autoincrement())
  companyId  Int
  company    Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  propertyId Int
  property   Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amount     Int
  dueDate    DateTime
  paidAt     DateTime?
  status     PaymentStatus @default(PENDING)
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([companyId])
  @@index([propertyId])
}

// ─── Worker ──────────────────────────────────────────────
// A foreign-worker renter record MANAGED BY company staff (distinct from a login
// account — see the RENTER Role, which is orthogonal). Tenant-isolated by
// companyId, exactly like Property/Payment.
//
// Sensitive-PII (SECURITY_PRINCIPLES.md §7/§8): passport number and insurance
// policy number are REGULATED identifiers, stored ENCRYPTED at rest (AES-256-GCM,
// shared/utils/fieldEncryption). The *Enc columns hold ciphertext only; the
// plaintext is decrypted for a single authorized detail read and is NEVER returned
// in list responses, logs, URLs, or audit metadata. Expiry DATES stay plaintext —
// they are not sensitive on their own and drive the 90/60/30-day expiry alerts
// (derived at read time, mirroring the Payment "overdue" convention).
//
// `preferredLanguage` is reserved for the deferred AI-translation feature
// (Thai/Hindi/Sinhala → Hebrew); no LLM pipeline is built yet.

model Worker {
  id                    Int       @id @default(autoincrement())
  companyId             Int
  company               Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Profile
  nameHe                String
  nameEn                String
  nationality           String
  entryDate             DateTime?
  preferredLanguage     String? // 'th' | 'hi' | 'si' | 'he'
  // Documents (number ENCRYPTED; expiry plaintext for alerts)
  passportNumberEnc     String?
  passportExpiry        DateTime?
  visaType              String?
  visaExpiry            DateTime?
  // Medical insurance (policy number ENCRYPTED; expiry plaintext)
  insuranceProvider     String?
  insurancePolicyNumEnc String?
  insuranceCoverageType String?
  insuranceExpiry       DateTime?
  // Contact + apartment assignment
  phone                 String?
  employer              String?
  propertyId            Int?
  property              Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  notes                 String?
  // ─ Mobile-app authentication (SECURITY_PRINCIPLES.md §3/§4/§24) ─
  // A worker is a STANDALONE login principal for the separate mobile app, issued
  // JWTs under a DISTINCT audience ('rentplus-worker') so the staff `authenticate`
  // can never accept one (and vice-versa). Staff auth is untouched. Login is
  // QR-identify + WhatsApp OTP — there is NO password. `authEnabled` gates login;
  // disabling it or rotating the QR bumps `tokenVersion` (revoke-all). Only HASHES
  // are stored (qrTokenHash, mfaCodeHash) — the raw QR token/OTP are never persisted.
  authEnabled           Boolean   @default(false)
  tokenVersion          Int       @default(0)
  // Normalized E.164 phone for the phone-number login path (kept separate from the
  // display `phone`). A PARTIAL UNIQUE index (WHERE authEnabled) — added via raw SQL
  // in the migration, since Prisma can't express a filtered unique — guarantees a
  // typed phone resolves to at most one app-enabled worker.
  phoneE164             String?
  // Opaque QR identifier. `qrTokenHash` (SHA-256) is the LOOKUP key used at login —
  // fast, indexed, unique. `qrTokenEnc` holds the SAME raw token ENCRYPTED at rest
  // (AES-256-GCM, shared/utils/fieldEncryption) so the manager UI can RE-RENDER the
  // QR on demand (GET .../qr) without re-issuing it. The raw token is useless without
  // the WhatsApp OTP. Rotating clears/replaces both; disabling leaves them but flips
  // authEnabled (login checks authEnabled), so a stale QR grants nothing.
  qrTokenHash           String?   @unique
  qrTokenEnc            String?
  // WhatsApp OTP (mirrors the User email-OTP columns): single-use, expiring,
  // attempt-capped. Only the hash is stored; the plaintext is sent, never persisted.
  mfaCodeHash           String?
  mfaCodeExpiresAt      DateTime?
  mfaCodeAttempts       Int       @default(0)
  lastLoginAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  documents     WorkerDocument[]
  refreshTokens WorkerRefreshToken[]
  requests      WorkerRequest[]

  @@index([companyId])
  @@index([propertyId])
  @@index([phoneE164])
}

// ─── WorkerRefreshToken ──────────────────────────────────
// Stateful, rotating refresh tokens for the WORKER principal (SECURITY_PRINCIPLES.md
// §4). A deliberate PARALLEL of `RefreshToken` (staff) rather than making that table
// polymorphic — the two principals stay fully isolated. Same hardening: only the
// SHA-256 hash is stored; each login opens a `familyId`; every rotate revokes the old
// row and issues a successor; replaying a revoked/expired token revokes the whole
// family AND bumps the worker's `tokenVersion` (revoke-all). FK cascades with Worker.

model WorkerRefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  workerId  Int
  worker    Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  familyId  String
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([workerId])
  @@index([familyId])
}

// ─── WorkerRequest ───────────────────────────────────────
// A maintenance/general request a worker submits from the mobile app to the
// managing company. Tenant-isolated by companyId (denormalized, like Payment).
// `companyId`/`workerId`/`status` are ALWAYS set server-side from the authenticated
// worker principal — never from the request body (mass-assignment defense, §10).

model WorkerRequest {
  id        Int                 @id @default(autoincrement())
  companyId Int
  company   Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workerId  Int
  worker    Worker              @relation(fields: [workerId], references: [id], onDelete: Cascade)
  type      WorkerRequestType
  message   String
  status    WorkerRequestStatus @default(OPEN)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([companyId])
  @@index([workerId])
}

// ─── WorkerDocument ──────────────────────────────────────
// An identity document (passport/visa/insurance scan) attached to a Worker.
// Sensitive-PII (SECURITY_PRINCIPLES.md §7/§8/§16): the FILE BYTES are the
// regulated data (a passport scan is the passport) and are stored ENCRYPTED at
// rest by the storage backend (AES-256-GCM, shared/storage/localFileStorage).
// This table holds only METADATA — never the bytes. `storageKey` is a
// server-generated UUID (never a client filename → no path traversal);
// `originalName` is display-only and treated as PII (never logged/audited).
// Tenant-isolated by companyId, exactly like Worker/Property.

model WorkerDocument {
  id           Int                @id @default(autoincrement())
  companyId    Int
  company      Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workerId     Int
  worker       Worker             @relation(fields: [workerId], references: [id], onDelete: Cascade)
  docType      WorkerDocumentType
  originalName String
  storageKey   String
  mimeType     String
  size         Int
  checksum     String
  createdAt    DateTime           @default(now())

  @@index([companyId])
  @@index([workerId])
}

// ─── PropertyImage ───────────────────────────────────────
// A photo attached to a Property (gallery). Mirrors WorkerDocument: the FILE
// BYTES are stored ENCRYPTED at rest by the storage backend (AES-256-GCM,
// shared/storage/localFileStorage) and this table holds only METADATA — never
// the bytes. `storageKey` is a server-generated UUID (never a client filename →
// no path traversal); `originalName` is display-only. Photos are not regulated
// PII like passport scans, but the same hardened storage seam + tenant isolation
// (by companyId) apply. Only image types are accepted (jpeg/png/webp), enforced
// by a magic-byte sniff in the service — the browser MIME is never trusted.

model PropertyImage {
  id           Int      @id @default(autoincrement())
  companyId    Int
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  propertyId   Int
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  originalName String
  storageKey   String
  mimeType     String
  size         Int
  checksum     String
  createdAt    DateTime @default(now())

  @@index([companyId])
  @@index([propertyId])
}

// ─── Property-detail data groups ─────────────────────────
// Each model is a property-scoped sub-resource, tenant-isolated by companyId
// (denormalized onto every row so repositories filter { companyId, propertyId }
// without a join, exactly like Payment). Both FKs cascade-delete with their
// parent. Money is Int (whole shekels), matching Payment/Property.monthlyRent.

// Utility & municipal bill (Arnona, electricity, water, Vaad Bayit, gas).
// "overdue" is derived at read time from dueDate — see UtilityBillStatus.
model UtilityBill {
  id         Int               @id @default(autoincrement())
  companyId  Int
  company    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  propertyId Int
  property   Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  type       UtilityType
  status     UtilityBillStatus @default(PENDING)
  amount     Int
  dueDate    DateTime
  paidAt     DateTime?
  notes      String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([companyId])
  @@index([propertyId])
}

// An inventory item held at a property.
model Equipment {
  id           Int                @id @default(autoincrement())
  companyId    Int
  company      Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  propertyId   Int
  property     Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name         String
  quantity     Int                @default(1)
  condition    EquipmentCondition @default(GOOD)
  serialNumber String?
  notes        String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([companyId])
  @@index([propertyId])
}

// A guarantee or deposit held against a property.
model Guarantee {
  id         Int             @id @default(autoincrement())
  companyId  Int
  company    Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  propertyId Int
  property   Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  type       GuaranteeType
  amount     Int
  bank       String?
  expiryDate DateTime?
  returnDate DateTime?
  status     GuaranteeStatus @default(ACTIVE)
  notes      String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([companyId])
  @@index([propertyId])
}

// A miscellaneous (non-rent) expense against a property.
model Expense {
  id         Int             @id @default(autoincrement())
  companyId  Int
  company    Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  propertyId Int
  property   Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  category   ExpenseCategory
  amount     Int
  date       DateTime
  notes      String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([companyId])
  @@index([propertyId])
}

// A periodic inspection record for a property.
model Inspection {
  id                 Int       @id @default(autoincrement())
  companyId          Int
  company            Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  propertyId         Int
  property           Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  lastInspectionDate DateTime?
  nextInspectionDate DateTime?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([companyId])
  @@index([propertyId])
}
