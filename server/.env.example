# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rentplus?schema=public"

# Dedicated database for integration tests (npm run test:integration).
# Must be a SEPARATE, clearly test-only database — the safety guard refuses to run
# unless the database name contains "test" and differs from DATABASE_URL.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/rentplus_test?schema=public"

# Server
PORT=5001
NODE_ENV=development

# Auth
# Generate a strong, unique secret (>= 32 chars). Do NOT commit the real value.
#   openssl rand -base64 48
# Production startup REFUSES to boot with a missing, placeholder, or weak secret.
JWT_SECRET="REPLACE_WITH_STRONG_RANDOM_SECRET"

# CORS — the client dev origin
CLIENT_URL="http://localhost:5173"
