# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rentplus?schema=public"

# Dedicated database for integration tests (npm run test:integration).
# Must be a SEPARATE, clearly test-only database — the safety guard refuses to run
# unless the database name contains "test" and differs from DATABASE_URL.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/rentplus_test?schema=public"

# Server
PORT=5001
NODE_ENV=development

# Operational logging (SECURITY §19). Minimum level to emit: debug | info | warn |
# error | silent. Optional — defaults to "info" in production, "debug" otherwise.
# Logs are structured (compact JSON in production, human-readable in dev) and pass
# through redaction so secrets (passwords, tokens, cookies) never appear. Audit
# logs are a SEPARATE, durable trail in the AuditLog table.
# LOG_LEVEL=info

# Auth
# Generate a strong, unique secret (>= 32 chars). Do NOT commit the real value.
#   openssl rand -base64 48
# Production startup REFUSES to boot with a missing, placeholder, or weak secret.
JWT_SECRET="REPLACE_WITH_STRONG_RANDOM_SECRET"

# MFA (TOTP) — key used to AES-256-GCM encrypt each user's TOTP secret at rest
# (SECURITY §3/§8). Generate a strong, unique value (>= 32 chars); do NOT commit
# the real value or reuse JWT_SECRET. Production startup REFUSES to boot without a
# strong, non-placeholder key. Rotating it invalidates existing stored secrets
# (users must re-enroll), so treat rotation as a deliberate operation.
#   openssl rand -base64 48
MFA_ENCRYPTION_KEY="REPLACE_WITH_STRONG_RANDOM_KEY"

# Field-level PII encryption — AES-256-GCM key for regulated identifiers
# (foreign-worker passport number, insurance policy number) stored encrypted at
# rest (SECURITY §7/§8). MUST be exactly 64 hex chars (32 bytes). Generate with:
#   openssl rand -hex 32
# Production startup REFUSES to boot without it. Rotating it makes previously
# encrypted values undecryptable, so treat rotation as a deliberate migration.
FIELD_ENCRYPTION_KEY="REPLACE_WITH_64_HEX_CHARS"

# Local storage directory for uploaded worker identity documents (SECURITY §16).
# Files are AES-256-GCM encrypted at rest (using FIELD_ENCRYPTION_KEY). MUST be a
# PRIVATE path outside any web-served directory. Optional — defaults to
# ./uploads/worker-documents. A future S3 backend makes this unused.
FILE_STORAGE_DIR="./uploads/worker-documents"

# CORS + CSRF — the client origin. Also the single allowed Origin/Referer the
# CSRF check accepts on authenticated state-changing requests (SECURITY §13).
# Production REFUSES to boot if this is missing or points at localhost.
CLIENT_URL="http://localhost:5173"

# Rate limiting (SECURITY §15/§28). Optional — sensible defaults live in
# src/shared/config/rateLimit.ts. Set any of these to tune per environment; each
# must be a positive integer. Windows are in milliseconds. All limits are
# window-based (auto-reset) — there are NO permanent account lockouts.
#   Login (per IP, all attempts):                     default 30 / 15 min
#   Login (per email+IP, failed attempts):            default  8 / 15 min
#   Login (per email across ALL IPs, failed only):    default 25 / 15 min
#   Refresh (per IP):                                 default 60 / 15 min
# The account-level cap (email across all IPs) stops DISTRIBUTED attacks that
# spread many source IPs across one account. It is deliberately WELL ABOVE the
# email+IP cap (8) to bound account-DoS risk; it is still window-based, no lockout.
# RATE_LIMIT_LOGIN_IP_MAX=30
# RATE_LIMIT_LOGIN_IP_WINDOW_MS=900000
# RATE_LIMIT_LOGIN_EMAIL_MAX=8
# RATE_LIMIT_LOGIN_EMAIL_WINDOW_MS=900000
# RATE_LIMIT_LOGIN_ACCOUNT_MAX=25
# RATE_LIMIT_LOGIN_ACCOUNT_WINDOW_MS=900000
# RATE_LIMIT_REFRESH_MAX=60
# RATE_LIMIT_REFRESH_WINDOW_MS=900000
#   Forgot-password (per email+IP):                   default  5 / 60 min
#   Reset-password  (per IP):                          default  5 / 60 min
#   Invitation accept (per IP):                        default  5 / 60 min
# Reset/invitation are keyed per IP (NOT per token): keying on the token would give
# an attacker a fresh bucket per guess. The token is 256-bit random (unguessable);
# per-IP is the meaningful abuse brake. Forgot-password keys on email+IP (body-only,
# so it behaves identically for existing vs non-existing emails — enumeration-safe).
# RATE_LIMIT_FORGOT_PASSWORD_MAX=5
# RATE_LIMIT_FORGOT_PASSWORD_WINDOW_MS=3600000
# RATE_LIMIT_PASSWORD_RESET_MAX=5
# RATE_LIMIT_PASSWORD_RESET_WINDOW_MS=3600000
# RATE_LIMIT_INVITATION_MAX=5
# RATE_LIMIT_INVITATION_WINDOW_MS=3600000
#   MFA verify/challenge (per email+IP, failed attempts): default 5 / 15 min
# RATE_LIMIT_MFA_VERIFY_MAX=5
# RATE_LIMIT_MFA_VERIFY_WINDOW_MS=900000
# NOTE: the default store is in-memory (per-process). A multi-instance production
# deployment needs a shared store (e.g. Redis) — deployment-dependent, not yet wired.

# Trusted reverse-proxy hop count (app.set('trust proxy', N)). Deployment-dependent.
# LEAVE UNSET in dev / when directly exposed (secure default = OFF): X-Forwarded-For
# is ignored so req.ip is the real socket peer and CANNOT be spoofed to evade the
# per-IP rate limiters. Behind a known proxy/CDN, set the EXACT number of trusted
# hops (a positive integer — never "true"). Must be a positive integer if set.
# TRUST_PROXY=1

# Account-mail delivery (invitation / password-reset links). No provider is wired
# yet (open decision). In dev the console mailer prints the link (NODE_ENV != production
# only — a raw token must NEVER reach production logs, SECURITY §7/§18). A real
# provider's credentials would go here when chosen. The reset/invite LINKS are built
# from CLIENT_URL above (e.g. CLIENT_URL/accept-invitation?token=... ).
